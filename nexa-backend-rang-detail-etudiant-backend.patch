+  admin   User   @relation("MessageSender", fields: [adminId], references: [id], onDelete: Cascade)
+  subject String
+  message String    @db.Text
+  readAt  DateTime?
+
+  createdAt DateTime @default(now())
+
+  @@map("admin_messages")
+}
